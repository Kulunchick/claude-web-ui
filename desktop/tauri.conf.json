{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Web UI",
  "version": "0.1.0",
  "identifier": "com.claudewebui.desktop",
  "build": {"frontendDist": "assets"},
  "app": {
    "withGlobalTauri": true,
    "windows": [{"label": "profiles", "title": "Gateway Profiles", "width": 640, "height": 620}],
    "security": {"csp": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"}
  },
  "bundle": {"active": true, "icon": ["icons/icon.png", "icons/icon.ico"]}
}
